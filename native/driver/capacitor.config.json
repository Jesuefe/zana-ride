{
  "appId": "rw.zanaride.driver",
  "appName": "Zana Driver",
  "webDir": "www",
  "server": {
    "url": "https://driver.zanaride.rw",
    "cleartext": false,
    "androidScheme": "https",
    "errorPath": "error.html"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "useLegacyBridge": true
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "Geolocation": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "Camera": {
      "presentationStyle": "fullscreen"
    }
  }
}