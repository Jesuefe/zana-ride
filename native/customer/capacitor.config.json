{
  "appId": "rw.zanaride.app",
  "appName": "Zana",
  "webDir": "www",
  "server": {
    "url": "https://app.zanaride.rw",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
