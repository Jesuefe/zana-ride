generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(uuid())
  phone                String               @unique
  phoneVerified        Boolean              @default(true)
  email                String?              @unique
  password             String?
  mustChangePassword   Boolean              @default(false)
  adminTotpSecretEnc   String?
  adminTotpPendingSecretEnc String?
  adminTotpEnabled     Boolean              @default(false)
  adminTotpEnabledAt   DateTime?
  adminTotpRecoveryCodes String?
  firstName            String?
  lastName             String?
  role                 UserRole             @default(CUSTOMER)
  status               UserStatus           @default(ACTIVE)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  language             String               @default("en")
  testOverrideLat      Float?
  testOverrideLng      Float?
  agent                Agent?
  callsMade            Call[]               @relation("CallsMade")
  callsReceived        Call[]               @relation("CallsReceived")
  cancellations        CancellationRecord[] @relation("Cancellations")
  sentMessages         ChatMessage[]        @relation("SentMessages")
  reportsReceived      CustomerReport[]     @relation("ReportsReceived")
  reportsMade          CustomerReport[]     @relation("ReportsMade")
  deliveries           Delivery[]           @relation("CustomerDeliveries")
  driver               Driver?
  merchant             Merchant?
  orders               Order[]              @relation("CustomerOrders")
  pushTokens           PushToken[]
  ratingsGiven         Rating[]             @relation("RatingsGiven")
  ratingsReceived      Rating[]             @relation("RatingsReceived")
  reviewsGiven         Review[]             @relation("ReviewsGiven")
  savedPlaces          SavedPlace[]         @relation("SavedPlaces")
  scheduledRides       ScheduledRide[]      @relation("ScheduledRides")
  sosAlerts            SosAlert[]           @relation("SosAlerts")
  staffMember          StaffMember?
  assignedSupportChats SupportChat[]        @relation("SupportChatAssignedStaff")
  supportChats         SupportChat[]        @relation("SupportChatCustomer")
  tripsAsCustomer      Trip[]               @relation("CustomerTrips")
  tripReports          TripReport[]
  wallet               Wallet?
  points               ZanaPoints?          @relation("UserPoints")
}

model Driver {
  id               String               @id @default(uuid())
  userId           String               @unique
  vehicle          String
  plate            String
  serviceType      ServiceType
  approvalStatus   DriverApprovalStatus @default(PENDING)
  onlineStatus     DriverOnlineStatus   @default(OFFLINE)
  driverMode       DriverMode           @default(BOTH)
  rating           Float                @default(0)
  totalTrips       Int                  @default(0)
  acceptanceRate   Float                @default(0)
  cancellationRate Float                @default(0)
  lastLat          Float?
  lastLng          Float?
  lastLocationAt   DateTime?
  activeSessionId  String?
  testOverrideLat  Float?
  testOverrideLng  Float?
  createdAt        DateTime             @default(now())
  commissionDebts  CommissionDebt[]     @relation("DriverDebts")
  debtSettlements  DebtSettlement[]     @relation("DriverSettlements")
  deliveries       Delivery[]           @relation("DriverDeliveries")
  user             User                 @relation(fields: [userId], references: [id])
  documents        DriverDocument[]
  vehicles         DriverVehicle[]
  rideOffers       RideOffer[]
  trips            Trip[]               @relation("DriverTrips")
}

model DriverDocument {
  id              String         @id @default(uuid())
  driverId        String
  vehicleId       String?
  label           String
  fileUrl         String?
  verified        Boolean        @default(false)
  reviewStatus    String         @default("PENDING")
  expiresAt       DateTime?
  rejectionReason String?
  supersededAt    DateTime?
  createdAt       DateTime       @default(now())
  driver          Driver         @relation(fields: [driverId], references: [id])
  vehicle         DriverVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([driverId, label, createdAt])
  @@index([vehicleId, createdAt])
  @@index([reviewStatus, expiresAt])
}

model DriverVehicle {
  id                 String           @id @default(uuid())
  driverId           String
  vehicleType        String
  make               String?
  model              String?
  year               Int?
  color              String?
  plate              String
  registrationNumber String?
  chassisNumber      String?
  ownershipType      String           @default("SELF")
  status             String           @default("PENDING")
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  driver             Driver           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  documents          DriverDocument[]

  @@index([driverId, status, createdAt])
  @@index([plate])
}

model Merchant {
  logoUrl                  String?
  coverUrl                 String?
  prepMinutes              Int                  @default(20)
  deliveryMinutes          Int                  @default(25)
  id                       String               @id @default(uuid())
  userId                   String               @unique
  businessName             String
  branch                   String?
  category                 MerchantCategory     @default(GOODS)
  status                   MerchantStatus       @default(PENDING)
  whatsappPhone            String?
  businessLat              Float?
  businessLng              Float?
  businessAddress          String?
  createdAt                DateTime             @default(now())
  businessCertificateUrl   String?
  businessPremisesPhotoKey String?
  payoutLockedAt           DateTime?
  payoutPhone              String?
  payoutProvider           String?
  payoutVerifiedAt         DateTime?
  promoExempt              Boolean              @default(false)
  promoExemptionReason     String?
  promotions               MerchantPromotion[]
  deliveries               Delivery[]
  user                     User                 @relation(fields: [userId], references: [id])
  settlements              MerchantSettlement[]
  orders                   Order[]              @relation("MerchantOrders")
  products                 Product[]
  reviews                  Review[]
}

model Product {
  id            String               @id @default(uuid())
  merchantId    String?
  marketId      String?
  name          String
  description   String?
  price         Int
  referenceCost Int?
  imageUrl      String?
  category      MerchantCategory
  status        ProductStatus        @default(PENDING)
  stock         Int                  @default(0)
  available     Boolean              @default(true)
  adminNote     String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  priceHistory  MarketPriceHistory[]
  orderItems    OrderItem[]
  promotionItems MerchantPromotionItem[]
  market        Market?              @relation(fields: [marketId], references: [id])
  merchant      Merchant?            @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([marketId])
}

model MerchantPromotion {
  id          String                   @id @default(uuid())
  merchantId  String
  title       String
  description String?
  comboPrice  Int
  startsAt    DateTime
  endsAt      DateTime
  status      String                   @default("PENDING")
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  merchant    Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items       MerchantPromotionItem[]
  orders      Order[]

  @@index([merchantId, startsAt, endsAt])
  @@index([status, startsAt, endsAt])
}

model MerchantPromotionItem {
  id           String            @id @default(uuid())
  promotionId  String
  productId    String
  promotion    MerchantPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([productId])
}

model Market {
  id                String    @id @default(uuid())
  name              String
  description       String?
  address           String
  lat               Float
  lng               Float
  pickupContactName String?
  pickupPhone       String?
  imageUrl          String?
  coverUrl          String?
  prepMinutes       Int       @default(30)
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  agents            Agent[]
  orders            Order[]
  products          Product[]
  reviews           Review[]
}

model Agent {
  id          String            @id @default(uuid())
  userId      String            @unique
  marketId    String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  market      Market?           @relation(fields: [marketId], references: [id])
  user        User              @relation(fields: [userId], references: [id])
  settlements AgentSettlement[]
  orders      Order[]
}

model Trip {
  id                 String        @id @default(uuid())
  customerId         String
  driverId           String?
  serviceType        ServiceType
  groupId            String?
  groupSeatIndex     Int?
  pickupAddress      String
  pickupLat          Float
  pickupLng          Float
  destinationAddress String
  destinationLat     Float
  destinationLng     Float
  distanceKm         Float?
  estimatedFare      Int
  promoCode          String?
  promoDiscount      Int           @default(0)
  customerPayableFare Int?
  finalFare          Int?
  status             TripStatus    @default(REQUESTED)
  paymentMethod      String        @default("CASH")
  momoRef            String?
  commissionDebt     Int           @default(0)
  cancelReason       String?
  requestedAt        DateTime      @default(now())
  acceptedAt         DateTime?
  arrivedAt          DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  calls              Call[]
  messages           ChatMessage[]
  ratings            Rating[]
  offers             RideOffer[]
  sosAlerts          SosAlert[]
  customer           User          @relation("CustomerTrips", fields: [customerId], references: [id])
  driver             Driver?       @relation("DriverTrips", fields: [driverId], references: [id])
  reports            TripReport[]
}

model RideOffer {
  id          String    @id @default(uuid())
  tripId      String
  driverId    String
  status      String    @default("PENDING")
  distanceKm  Float
  offeredAt   DateTime  @default(now())
  expiresAt   DateTime
  respondedAt DateTime?
  driver      Driver    @relation(fields: [driverId], references: [id])
  trip        Trip      @relation(fields: [tripId], references: [id])

  @@unique([tripId, driverId])
  @@index([tripId])
  @@index([driverId, status])
}

model TripReport {
  id         String    @id @default(uuid())
  tripId     String
  reporterId String
  reason     String
  details    String?
  status     String    @default("OPEN")
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())
  reporter   User      @relation(fields: [reporterId], references: [id])
  trip       Trip      @relation(fields: [tripId], references: [id])
}

model SavedPlace {
  id        String   @id @default(uuid())
  userId    String
  label     String
  address   String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  user      User     @relation("SavedPlaces", fields: [userId], references: [id])
}

model MerchantInvite {
  id        String    @id @default(uuid())
  token     String    @unique @default(uuid())
  createdBy String
  usedBy    String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model CommissionDebt {
  id         String    @id @default(uuid())
  driverId   String
  amount        Int
  settledAmount Int       @default(0)
  tripId        String?
  deliveryId String?
  paidAt     DateTime?
  settledVia String?
  createdAt  DateTime  @default(now())
  driver     Driver    @relation("DriverDebts", fields: [driverId], references: [id])
}

model DebtSettlement {
  id          String   @id @default(uuid())
  driverId    String
  amount      Int
  providerRef String   @unique
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  driver      Driver   @relation("DriverSettlements", fields: [driverId], references: [id])

  @@index([driverId])
}

model Rating {
  id         String   @id @default(uuid())
  tripId     String
  fromUserId String
  toUserId   String
  rating     Int
  comment    String?
  raterRole  String   @default("CUSTOMER")
  createdAt  DateTime @default(now())
  fromUser   User     @relation("RatingsGiven", fields: [fromUserId], references: [id])
  toUser     User     @relation("RatingsReceived", fields: [toUserId], references: [id])
  trip       Trip     @relation(fields: [tripId], references: [id])
}

model FareConfig {
  id                 String      @id @default(uuid())
  serviceType        ServiceType @unique
  base               Int
  perKm              Int
  perMin             Int
  bookingFee         Int
  minimum            Int
  commissionRate     Float       @default(15)
  freeWaitingMinutes Int         @default(10)
  waitingPerMinute   Int         @default(100)
  updatedAt          DateTime    @updatedAt
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  balance      Int                 @default(0)
  createdAt    DateTime            @default(now())
  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]
}

model WalletTransaction {
  id            String                  @id @default(uuid())
  walletId      String
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  reference     String?
  providerRef   String?                 @unique
  description   String?
  status        WalletTransactionStatus @default(COMPLETED)
  createdAt     DateTime                @default(now())
  wallet        Wallet                  @relation(fields: [walletId], references: [id])
}

model Delivery {
  id               String         @id @default(uuid())
  merchantId       String?
  orderId          String?        @unique
  customerId       String?
  driverId         String?
  itemDescription  String
  weight           PackageWeight
  imageUrl         String?
  pickupAddress    String
  pickupLat        Float
  pickupLng        Float
  dropoffAddress   String
  dropoffLat       Float
  dropoffLng       Float
  trackingCode     String?        @unique
  pickupPhotoUrl   String?
  dropoffPhotoUrl  String?
  paymentMethod    String         @default("WALLET")
  paid             Boolean        @default(false)
  momoRef          String?
  routeSequence    Int?
  acceptDeadline   DateTime?
  receiverName     String?
  receiverPhone    String
  distanceKm       Float
  fee              Int
  status           DeliveryStatus @default(REQUESTED)
  createdAt        DateTime       @default(now())
  assignedAt       DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  imageDeleteAfter DateTime?
  calls            Call[]
  messages         ChatMessage[]
  customer         User?          @relation("CustomerDeliveries", fields: [customerId], references: [id])
  driver           Driver?        @relation("DriverDeliveries", fields: [driverId], references: [id])
  merchant         Merchant?      @relation(fields: [merchantId], references: [id])
  order            Order?         @relation(fields: [orderId], references: [id])
  reviews          Review[]
}

model LocationCode {
  id        String    @id @default(uuid())
  code      String    @unique
  lat       Float
  lng       Float
  address   String?
  createdBy String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Commission {
  id                  String   @id @default(uuid())
  tripId              String?  @unique
  deliveryId          String?  @unique
  amount              Int
  ratePercent         Float
  walletCoveredAmount Int      @default(0)
  debtCreatedAmount   Int      @default(0)
  createdAt           DateTime @default(now())
}

model Expense {
  id               String    @id @default(uuid())
  title            String
  amount           Int
  category         String
  description      String?
  vendor           String?
  invoiceNumber    String?
  paymentReference String?
  paymentStatus    String    @default("UNPAID")
  amountPaid       Int       @default(0)
  status           String    @default("PENDING")
  dueDate          DateTime?
  paidAt           DateTime?
  voidedAt         DateTime?
  voidReason       String?
  date             DateTime  @default(now())
  createdAt        DateTime  @default(now())

  @@index([date, status])
  @@index([category, date])
}

model StaffMember {
  id             String          @id @default(uuid())
  userId         String?         @unique
  name           String
  role           String
  accessRole     String          @default("OPERATIONS")
  phone          String?
  email          String?
  salary         Int
  department     String?
  employmentType String          @default("EMPLOYEE")
  active         Boolean         @default(true)
  startDate      DateTime        @default(now())
  endDate        DateTime?
  createdAt      DateTime        @default(now())
  payments       SalaryPayment[]
  salaryHistory  StaffSalaryHistory[]
  payrollLines   PayrollLine[]
  salaryAdvances SalaryAdvance[]
  contractorInvoices ContractorInvoice[]
  user           User?           @relation(fields: [userId], references: [id])
}

model StaffSalaryHistory {
  id            String      @id @default(uuid())
  staffMemberId String
  baseSalary    Int
  effectiveFrom DateTime
  createdAt     DateTime    @default(now())
  staff         StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@index([staffMemberId, effectiveFrom])
}

model SalaryPayment {
  id               String      @id @default(uuid())
  staffMemberId    String
  amount           Int
  month            String
  paid             Boolean     @default(false)
  paidAt           DateTime?
  paymentReference String?
  paymentMethod    String?
  note             String?
  createdAt        DateTime    @default(now())
  staff            StaffMember @relation(fields: [staffMemberId], references: [id])
  payrollLineId    String?
  payrollLine      PayrollLine? @relation(fields: [payrollLineId], references: [id])

  @@index([month, paid])
  @@index([staffMemberId, month])
  @@index([payrollLineId])
}


model PayrollRun {
  id                       String        @id @default(uuid())
  month                    String        @unique
  status                   String        @default("DRAFT")
  currency                 String        @default("RWF")
  totalGross               Int           @default(0)
  totalNetPay              Int           @default(0)
  totalEmployeeDeductions  Int           @default(0)
  totalEmployerStatutory   Int           @default(0)
  totalEmployerCost        Int           @default(0)
  createdBy                String?
  approvedBy               String?
  approvedAt               DateTime?
  paidAt                   DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  lines                    PayrollLine[]

  @@index([status, month])
}

model PayrollLine {
  id                       String        @id @default(uuid())
  payrollRunId             String
  staffMemberId            String
  baseSalary               Int
  taxableAllowances        Int           @default(0)
  nonTaxableAllowances     Int           @default(0)
  pensionableAllowances    Int           @default(0)
  bonus                    Int           @default(0)
  otherDeductions          Int           @default(0)
  advanceDeduction         Int           @default(0)
  taxableGross             Int
  pensionableGross         Int
  paye                     Int
  employeePension          Int
  employerPension          Int
  employerOccupational     Int
  employeeMaternity        Int
  employerMaternity        Int
  cbhi                     Int
  employeeDeductions       Int
  netPay                   Int
  employerStatutoryCost    Int
  totalEmployerCost        Int
  paidAmount               Int           @default(0)
  status                   String        @default("AWAITING_APPROVAL")
  payslipSnapshot          String
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  payrollRun               PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  staff                    StaffMember   @relation(fields: [staffMemberId], references: [id])
  payments                 SalaryPayment[]
  advanceRecoveries        SalaryAdvanceRecovery[]

  @@unique([payrollRunId, staffMemberId])
  @@index([staffMemberId, payrollRunId])
  @@index([status])
}

model Order {
  id                       String              @id @default(uuid())
  customerId               String
  merchantId               String?
  marketId                 String?
  promotionId              String?
  agentId                  String?
  total                    Int
  promoCode                String?
  promoDiscount            Int                 @default(0)
  deliveryFee              Int                 @default(0)
  status                   OrderStatus         @default(PENDING)
  deliveryId               String?
  note                     String?
  paymentMethod            String              @default("CASH")
  paid                     Boolean             @default(false)
  momoRef                  String?
  prepMinutes              Int?
  trackingCode             String?             @unique
  pickupPhotoUrl           String?
  dropoffPhotoUrl          String?
  dropoffAddress           String?
  dropoffLat               Float?
  dropoffLng               Float?
  receiverPhone            String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  preparingAt              DateTime?
  readyAt                  DateTime?
  actualPrepMinutes        Int?
  estimatedDeliveryMinutes Int?
  agentSettlement          AgentSettlement?
  delivery                 Delivery?
  merchantSettlement       MerchantSettlement?
  agent                    Agent?              @relation(fields: [agentId], references: [id])
  customer                 User                @relation("CustomerOrders", fields: [customerId], references: [id])
  market                   Market?             @relation(fields: [marketId], references: [id])
  merchant                 Merchant?           @relation("MerchantOrders", fields: [merchantId], references: [id])
  promotion                MerchantPromotion?   @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  items                    OrderItem[]

  @@index([merchantId, status, createdAt])
  @@index([promotionId])
  @@index([merchantId, readyAt])
  @@index([marketId, status, createdAt])
  @@index([agentId, status, createdAt])
}

model OrderItem {
  id                   String    @id @default(uuid())
  orderId              String
  productId            String
  quantity             Int
  price                Int
  actualPurchasePrice  Int?
  referenceCostAtOrder Int?
  status               String    @default("AVAILABLE")
  refundedAmount       Int       @default(0)
  unavailableAt        DateTime?
  order                Order     @relation(fields: [orderId], references: [id])
  product              Product   @relation(fields: [productId], references: [id])
}

model ChatMessage {
  id              String    @id @default(uuid())
  tripId          String?
  deliveryId      String?
  senderId        String
  content         String
  originalLang    String    @default("en")
  translatedEn    String?
  translatedFr    String?
  translatedRw    String?
  hiddenFromUsers Boolean   @default(false)
  createdAt       DateTime  @default(now())
  delivery        Delivery? @relation(fields: [deliveryId], references: [id])
  sender          User      @relation("SentMessages", fields: [senderId], references: [id])
  trip            Trip?     @relation(fields: [tripId], references: [id])
}

model SosAlert {
  id             String    @id @default(uuid())
  tripId         String?
  customerId     String
  lat            Float?
  lng            Float?
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  customer       User      @relation("SosAlerts", fields: [customerId], references: [id])
  trip           Trip?     @relation(fields: [tripId], references: [id])
}

model ZanaPoints {
  id           String             @id @default(uuid())
  userId       String             @unique
  balance      Int                @default(0)
  totalEarned  Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  transactions PointTransaction[]
  user         User               @relation("UserPoints", fields: [userId], references: [id])
}

model PointTransaction {
  id        String     @id @default(uuid())
  pointsId  String
  amount    Int
  reason    String
  tripId    String?
  createdAt DateTime   @default(now())
  points    ZanaPoints @relation(fields: [pointsId], references: [id])
}

model ScheduledRide {
  id                 String      @id @default(uuid())
  customerId         String
  pickupAddress      String
  pickupLat          Float
  pickupLng          Float
  destinationAddress String
  destinationLat     Float
  destinationLng     Float
  serviceType        ServiceType
  scheduledFor       DateTime
  specialRequest     String?
  paymentMethod      String      @default("CASH")
  status             String      @default("PENDING")
  tripId             String?
  createdAt          DateTime    @default(now())
  customer           User        @relation("ScheduledRides", fields: [customerId], references: [id])
}

model CancellationRecord {
  id         String   @id @default(uuid())
  customerId String
  tripId     String?
  reason     String?
  createdAt  DateTime @default(now())
  customer   User     @relation("Cancellations", fields: [customerId], references: [id])
}

model CustomerReport {
  id         String   @id @default(uuid())
  reporterId String
  reportedId String
  tripId     String?
  reason     String
  details    String?
  createdAt  DateTime @default(now())
  reported   User     @relation("ReportsReceived", fields: [reportedId], references: [id])
  reporter   User     @relation("ReportsMade", fields: [reporterId], references: [id])
}

model Call {
  id            String     @id @default(uuid())
  rideId        String?
  deliveryId    String?
  callerId      String
  receiverId    String
  roomName      String     @unique
  status        CallStatus @default(INITIATING)
  startedAt     DateTime   @default(now())
  answeredAt    DateTime?
  connectedAt   DateTime?
  endedAt       DateTime?
  expiresAt     DateTime
  endedBy       String?
  failureReason String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  caller        User       @relation("CallsMade", fields: [callerId], references: [id])
  delivery      Delivery?  @relation(fields: [deliveryId], references: [id])
  receiver      User       @relation("CallsReceived", fields: [receiverId], references: [id])
  trip          Trip?      @relation(fields: [rideId], references: [id])
}

model Review {
  id         String       @id @default(uuid())
  target     ReviewTarget
  rating     Int
  comment    String?
  fromUserId String
  deliveryId String?
  merchantId String?
  marketId   String?
  orderId    String?
  createdAt  DateTime     @default(now())
  delivery   Delivery?    @relation(fields: [deliveryId], references: [id])
  fromUser   User         @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  market     Market?      @relation(fields: [marketId], references: [id])
  merchant   Merchant?    @relation(fields: [merchantId], references: [id])

  @@index([merchantId])
  @@index([deliveryId])
}

model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String   @default("android")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RecoveryEvent {
  id         String   @id @default(uuid())
  driverId   String
  rideId     String?
  event      String
  rideStatus String?
  createdAt  DateTime @default(now())

  @@index([driverId])
}

model MerchantSettlement {
  id               String   @id @default(uuid())
  orderId          String   @unique
  merchantId       String
  grossAmount      Int
  commissionRate   Float
  commissionAmount Int
  merchantNet      Int
  status           String   @default("SETTLED")
  createdAt        DateTime @default(now())
  settledAt        DateTime @default(now())
  merchant         Merchant @relation(fields: [merchantId], references: [id])
  order            Order    @relation(fields: [orderId], references: [id])

  @@index([merchantId, createdAt])
}

model AgentSettlement {
  id                 String   @id @default(uuid())
  orderId            String   @unique
  agentId            String
  grossMargin        Int?
  underlyingAmount   Int?
  customerAmount     Int?
  markupAmount       Int?
  markupPercent      Float?
  agentRate          Float?
  zanaRate           Float?
  agentEarning       Int
  zanaEarning        Int
  actualPurchaseCost Int
  status             String   @default("SETTLED")
  createdAt          DateTime @default(now())
  settledAt          DateTime @default(now())
  agent              Agent    @relation(fields: [agentId], references: [id])
  order              Order    @relation(fields: [orderId], references: [id])

  @@index([agentId, createdAt])
}

model MarketPriceConfig {
  id                 String   @id @default(uuid())
  autoApprovePercent Float    @default(15)
  hardRejectPercent  Float    @default(100)
  markupPercent      Float    @default(20)
  agentEarningRate   Float    @default(40)
  zanaMarkupShare    Float    @default(60)
  agentMarkupShare   Float    @default(40)
  updatedAt          DateTime @updatedAt
}

model MarketPriceHistory {
  id               String    @id @default(uuid())
  productId        String
  marketId         String
  oldPrice         Int?
  newPrice         Int
  oldReferenceCost Int?
  newReferenceCost Int?
  changedBy        String
  reason           String?
  status           String    @default("APPROVED")
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  product          Product   @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
  @@index([marketId, status])
}

model ImpactFundConfig {
  id              String   @id @default("default")
  ratePercent     Float    @default(3)
  profitBasedFrom DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ImpactFundEntry {
  id                 String   @id @default(uuid())
  sourceType         String
  sourceId           String
  eventType          String
  grossAmount        Int
  platformCommission Int
  contributionAmount Int
  ratePercent        Float
  status             String   @default("ACCRUED")
  idempotencyKey     String   @unique
  description        String?
  createdAt          DateTime @default(now())

  @@index([sourceType, sourceId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
}

model ImpactFundDisbursement {
  id               String    @id @default(uuid())
  amount           Int
  currency         String    @default("RWF")
  recipientName    String
  recipientType    String    @default("PROGRAM")
  purpose          String
  status           String    @default("REQUESTED")
  requestedBy      String
  approvedBy       String?
  paidBy           String?
  paymentMethod    String?
  paymentReference String?
  evidenceUrl      String?
  rejectionReason  String?
  rejectedBy       String?
  rejectedAt       DateTime?
  requestedAt      DateTime  @default(now())
  approvedAt       DateTime?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, requestedAt])
  @@index([requestedBy, requestedAt])
  @@index([paymentReference])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  entityType   String
  entityId     String?
  beforeJson   String?
  afterJson    String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model SupportChat {
  id                    String           @id @default(uuid())
  userId                String
  status                String           @default("open")
  assignedStaffId       String?
  category              String           @default("GENERAL")
  priority              String           @default("NORMAL")
  lastCustomerMessageAt DateTime?
  lastStaffMessageAt    DateTime?
  lastStaffReadAt       DateTime?
  firstResponseAt       DateTime?
  resolvedAt            DateTime?
  createdAt             DateTime         @default(now())
  closedAt              DateTime?
  assignedStaff         User?            @relation("SupportChatAssignedStaff", fields: [assignedStaffId], references: [id])
  user                  User             @relation("SupportChatCustomer", fields: [userId], references: [id], onDelete: Cascade)
  messages              SupportMessage[]

  @@index([status, createdAt])
  @@index([status, priority, createdAt])
  @@index([lastCustomerMessageAt, lastStaffReadAt])
  @@index([assignedStaffId, status, createdAt])
  @@index([userId, status])
}

model SupportMessage {
  id        String      @id @default(uuid())
  chatId    String
  sender    String
  text      String
  createdAt DateTime    @default(now())
  chat      SupportChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model SupportTicket {
  id               String    @id @default(uuid())
  ticketNumber     String    @unique @default(cuid())
  customerId       String?
  customerName     String
  customerPhone    String?
  subject          String
  description      String
  category         String    @default("GENERAL")
  priority         String    @default("NORMAL")
  status           String    @default("OPEN")
  relatedType      String?
  relatedReference String?
  assignedToId     String?
  internalNotes    String?
  resolution       String?
  createdById      String?
  lastUpdatedById  String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, priority, createdAt])
  @@index([customerPhone])
  @@index([relatedReference])
}

model RiderRegistration {
  id          String   @id @default(uuid())
  fullName    String
  phone       String
  email       String?
  vehicleType String
  powerType   String
  location    String
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model MerchantLead {
  id                 String    @id @default(uuid())
  businessName       String
  contactName        String
  category           String
  phone              String
  whatsappPhone      String?
  businessAddress    String
  locationsCount     String    @default("1")
  deliveryPreference String
  notes              String?
  status             String    @default("NEW")
  internalNotes      String?
  contactedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([businessName])
}

model ServiceZone {
  id            String   @id
  name          String
  city          String
  boundary      Json
  serviceTypes  String[] @default(["ALL"])
  nearbyZoneIds String[] @default([])
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  parentZoneId  String?
  zoneLevel     String   @default("MINI")

  @@index([parentZoneId])
  @@index([city, zoneLevel])
  @@index([city, active])
  @@index([active])
}

model AgentPurchaseFund {
  id               String    @id
  orderId          String    @unique
  agentId          String
  agentUserId      String
  authorizedAmount Int
  withdrawnAmount  Int       @default(0)
  actualSpend      Int?
  remainingAmount  Int?
  destinationPhone String
  status           String    @default("AVAILABLE")
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  withdrawnAt      DateTime? @db.Timestamptz(6)
  reconciledAt     DateTime? @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @db.Timestamptz(6)

  @@index([agentId, status, createdAt], map: "AgentPurchaseFund_agent_status_idx")
  @@index([orderId], map: "AgentPurchaseFund_order_idx")
}

