model SalaryAdvance {
  id                String                  @id @default(uuid())
  staffMemberId     String
  principalAmount   Int
  outstandingAmount Int
  monthlyDeduction  Int
  issuedAt          DateTime                @default(now())
  dueDate           DateTime?
  status            String                  @default("REQUESTED")
  approvedBy        String?
  approvedAt        DateTime?
  paymentReference  String?
  paymentMethod     String?
  paidAt            DateTime?
  note              String?
  createdBy         String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  staff             StaffMember             @relation(fields: [staffMemberId], references: [id])
  recoveries        SalaryAdvanceRecovery[]

  @@index([staffMemberId, status])
}

model SalaryAdvanceRecovery {
  id            String        @id @default(uuid())
  advanceId     String
  payrollLineId String
  amount        Int
  status        String        @default("RESERVED")
  postedAt      DateTime?
  createdAt     DateTime      @default(now())
  advance       SalaryAdvance @relation(fields: [advanceId], references: [id])
  payrollLine   PayrollLine   @relation(fields: [payrollLineId], references: [id], onDelete: Cascade)

  @@unique([advanceId, payrollLineId])
  @@index([payrollLineId, status])
}

model ContractorInvoice {
  id                String       @id @default(uuid())
  staffMemberId     String?
  contractorName    String
  invoiceNumber     String
  invoiceDate       DateTime
  dueDate           DateTime?
  description       String
  grossAmount       Int
  withholdingRate   Float        @default(0)
  withholdingAmount Int          @default(0)
  netPayable        Int
  amountPaid        Int          @default(0)
  currency          String       @default("RWF")
  status            String       @default("SUBMITTED")
  paymentReference  String?
  paymentMethod     String?
  paidAt            DateTime?
  evidenceUrl       String?
  reviewedBy        String?
  reviewedAt        DateTime?
  createdBy         String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  staff             StaffMember? @relation(fields: [staffMemberId], references: [id])

  @@unique([contractorName, invoiceNumber])
  @@index([status, invoiceDate])
}

model StatutoryRemittance {
  id                 String    @id @default(uuid())
  period             String
  obligationType     String
  amount             Int
  currency           String    @default("RWF")
  dueDate            DateTime?
  status             String    @default("DRAFT")
  sourcePayrollRunId String?
  paymentReference   String?
  paymentMethod      String?
  paidAt             DateTime?
  evidenceUrl        String?
  notes              String?
  accountantVerifiedBy String?
  accountantVerifiedAt DateTime?
  accountantVerificationNote String?
  createdBy          String?
  approvedBy         String?
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([period, obligationType])
  @@index([status, dueDate])
}

model PromoCode {
  id               String   @id @default(uuid())
  code             String   @unique
  name             String
  description      String?
  serviceScope     String   @default("ALL")
  discountType     String   @default("PERCENT")
  discountValue    Int
  maxDiscount      Int?
  minSpend         Int      @default(0)
  maxUses          Int?
  perUserLimit     Int      @default(1)
  usageCount       Int      @default(0)
  fundingSource    String   @default("ZANA")
  creatorName      String?
  creatorHandle    String?
  startsAt         DateTime
  endsAt           DateTime
  status           String   @default("ACTIVE")
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  redemptions      PromoCodeRedemption[]

  @@index([status, startsAt, endsAt])
  @@index([serviceScope])
}


model PromoCodeRedemption {
  id              String   @id @default(uuid())
  promoCodeId     String
  userId          String
  serviceScope    String
  originalAmount  Int
  discountAmount  Int
  payableAmount   Int
  tripId          String?  @unique
  orderId         String?  @unique
  status          String   @default("RESERVED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  promoCode       PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)

  @@index([promoCodeId, userId, status])
  @@index([userId, createdAt])
}
