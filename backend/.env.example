# Copy this file to .env and fill in real values before running.

DATABASE_URL="postgresql://zana:CHANGE_ME@localhost:5432/zana_db?schema=public"
JWT_SECRET="CHANGE_ME_to_a_long_random_string"
JWT_EXPIRES_IN="30d"
PORT=4000
DB_PASSWORD="CHANGE_ME"

# Gemini AI — server-side only; never expose this to web/mobile clients.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
REDIS_URL="redis://localhost:6379"

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""

EVERSEND_BASE_URL="https://api.eversend.co/v1"
EVERSEND_CLIENT_ID=""
EVERSEND_CLIENT_SECRET=""
EVERSEND_RWF_RAIL="mtn_momo"
SETTINGS_ENCRYPTION_KEY=""
EVERSEND_API_KEY=""
EVERSEND_WEBHOOK_SECRET=""
