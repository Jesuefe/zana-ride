# Copy this file to .env and fill in real values before running.

DATABASE_URL="postgresql://zana:CHANGE_ME@localhost:5432/zana_db?schema=public"
JWT_SECRET="CHANGE_ME_to_a_long_random_string"
JWT_EXPIRES_IN="30d"
PORT=4000

# Used by docker-compose.yml to set the Postgres password consistently
DB_PASSWORD="CHANGE_ME"

# Optional SOS emergency SMS via Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""

# Eversend money rail
EVERSEND_BASE_URL="https://api.eversend.co/v1"
EVERSEND_CLIENT_ID=""
EVERSEND_CLIENT_SECRET=""
EVERSEND_RWF_RAIL="mtn_momo"

# Admin-managed payment settings encryption master key\nSETTINGS_ENCRYPTION_KEY=""\nEVERSEND_API_KEY=""\nEVERSEND_BASE_URL="https://api.eversend.co/v1"\nEVERSEND_WEBHOOK_SECRET=""\nEVERSEND_RWF_RAIL="mtn_momo"\n