# Copy this file to .env and fill in real values before running.

DATABASE_URL="postgresql://zana:CHANGE_ME@localhost:5432/zana_db?schema=public"
JWT_SECRET="CHANGE_ME_to_a_long_random_string"
JWT_EXPIRES_IN="30d"
PORT=4000

# Used by docker-compose.yml to set the Postgres password consistently
DB_PASSWORD="CHANGE_ME"
